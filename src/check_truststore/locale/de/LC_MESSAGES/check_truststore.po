#, python-brace-format
msgid ""
"TrustStore Analyzer v{version} - Analyze certificate truststores and "
"visualize the chain hierarchy."
msgstr ""
"TrustStore Analyzer v{version} - Analysieren Sie Zertifikats-Truststores und "
"visualisieren Sie die Kettenhierarchie."

msgid "Compatible with Python 3.6+"
msgstr "Kompatibel mit Python 3.6+"

msgid "Show this help message and exit"
msgstr "Diese Hilfenachricht anzeigen und beenden"

msgid "Show program's version number and exit"
msgstr "Programmversionsnummer anzeigen und beenden"


msgid ""
"Certificate lacks CRL Distribution Points (CDP). Revocation checking may be "
"limited."
msgstr ""
"Le certificat ne contient pas de points de distribution CRL (CDP). La vérification "
"de révocation peut être limitée."

#: src/check_truststore/engine/policy.py:485
#, python-brace-format
msgid ""
"Path length constraint exceeded. Issuer allows max {limit} intermediate(s)."
msgstr ""
"Contrainte de longueur de chaîne dépassée. L'émetteur autorise max {limit} intermédiaire(s)."


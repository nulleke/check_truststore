msgid "The cryptographic signature is invalid or could not be verified."
msgstr "La signature cryptographique est invalide ou n'a pas pu être vérifiée."

#: src/check_truststore/engine/policy.py:105
#, python-brace-format
msgid "Issuer '{issuer}' is not a CA or lacks keyCertSign usage."
msgstr "L'émetteur '{issuer}' n'est pas une autorité de certification (CA) ou ne dispose pas de l'usage keyCertSign."

#: src/check_truststore/engine/policy.py:117
msgid ""
"The certificate issuer could not be found in the truststore, making this "
"chain untrusted."
msgstr ""
"L'émetteur du certificat est introuvable dans le magasin de confiance, "
"rendant cette chaîne non fiable."

#: src/check_truststore/engine/policy.py:124
msgid ""
"This certificate is untrusted because it or an issuer in its chain has been "
"revoked."
msgstr ""
"Ce certificat n'est pas fiable car il a été révoqué, ou l'un de ses émetteurs "
"dans la chaîne l'a été."

#: src/check_truststore/engine/policy.py:243
#, python-brace-format
msgid ""
"RSA key size ({bits} bits) is below the minimum required {min_bits} bits."
msgstr ""
"La taille de la clé RSA ({bits} bits) est inférieure au minimum requis de {min_bits} bits."

#: src/check_truststore/engine/policy.py:251
#, python-brace-format
msgid ""
"ECC key size ({bits} bits) is below the minimum required {min_bits} bits."
msgstr ""
"La taille de la clé ECC ({bits} bits) est inférieure au minimum requis de {min_bits} bits."


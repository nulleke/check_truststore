msgid "Serial"
msgstr "Série"

msgid "Unknown"
msgstr "Inconnu"

msgid ""
"This certificate is explicitly untrusted by the Operating System "
"(Blacklisted)."
msgstr ""
"Ce certificat est explicitement non fiable pour le système d'exploitation "
"(liste noire)."

#, python-brace-format
msgid "Certificate expires within {days} days."
msgstr "Le certificat expire dans {days} jours."

#, python-brace-format
msgid "Circular chain detected: {path}"
msgstr "Chaîne circulaire détectée : {path}"

msgid "CYCLE_BREAKER"
msgstr "RUPTEUR_CYCLE"

msgid "SIG_ERR"
msgstr "ERR_SIG"

msgid "REVOKED"
msgstr "RÉVOQUÉ"

msgid "INVALID"
msgstr "INVALIDE"

#, python-brace-format
msgid "Missing issuer for: {name}"
msgstr "Émetteur manquant pour : {name}"

msgid "UNTRUSTED"
msgstr "NON_FIABLE"

msgid "The certificate chain leads to an untrusted or missing root."
msgstr "La chaîne de certificats mène à une racine non approuvée ou manquante."

msgid "The certificate chain is incomplete due to a missing upstream issuer."
msgstr ""
"La chaîne de certificats est incomplète en raison d'un émetteur amont "
"manquant."

msgid ""
"The chain is untrusted because an upstream issuer is blacklisted by the OS."
msgstr ""
"La chaîne n'est pas fiable car un émetteur en amont est sur la liste noire "
"de l'OS."

#, python-brace-format
msgid "AIA: {name}"
msgstr "AIA : {name}"

msgid "Successfully discovered issuer via AIA"
msgstr "Émetteur découvert avec succès via AIA"

msgid "The chain is broken; an issuer (Root or Intermediate) was not found."
msgstr ""
"La chaîne est rompue ; un émetteur (racine ou intermédiaire) n'a pas été "
"trouvé."

msgid "A circular certificate reference was detected."
msgstr "Une référence de certificat circulaire a été détectée."

msgid "CACHE"
msgstr "CACHE"

msgid "Could not create cache directory"
msgstr "Impossible de créer le répertoire de cache"

msgid "AIA_CACHE"
msgstr "CACHE_AIA"

#, python-brace-format
msgid "Cache hit for AKI {aki}, skipping network."
msgstr "Correspondance en cache pour l'AKI {aki}, réseau ignoré."

msgid "AIA_FETCH"
msgstr "RÉCUP_AIA"

msgid "Bypassing cache due to --no-cache flag"
msgstr "Contournement du cache dû à l'option --no-cache"

msgid "AUDIT"
msgstr "AUDIT"

msgid "AIA_THREAD"
msgstr "FIL_AIA"

msgid "Thread error during discovery"
msgstr "Erreur de thread lors de la découverte"

msgid "Downloading"
msgstr "Téléchargement"

msgid "AIA_SIZE"
msgstr "TAILLE_AIA"

#, python-brace-format
msgid "Certificate at {url} exceeds size limit."
msgstr "Le certificat à l'URL {url} dépasse la limite de taille."

msgid "AIA_FAILED"
msgstr "ÉCHEC_AIA"

msgid "Connection failed"
msgstr "Échec de la connexion"

msgid "AIA_PARSE"
msgstr "ANALYSE_AIA"

#, python-brace-format
msgid "Failed to parse certificate from {url}"
msgstr "Impossible d'analyser le certificat de {url}"

msgid "OCSP_BUILD"
msgstr "CONST_OCSP"

msgid "OCSP thread error"
msgstr "Erreur de thread OCSP"

msgid "OCSP_THREAD"
msgstr "FIL_OCSP"

msgid "CRL_CHECK"
msgstr "VÉRIF_CRL"

msgid "No CRL endpoints found in certificate"
msgstr "Aucun point de terminaison CRL trouvé dans le certificat"

msgid "CRL thread error"
msgstr "Erreur de thread CRL"

msgid "CRL_THREAD"
msgstr "FIL_CRL"

msgid "DNS"
msgstr "DNS"

msgid "Could not resolve host"
msgstr "Impossible de résoudre l'hôte"

msgid "Cache"
msgstr "Cache"

msgid "Error reading cache"
msgstr "Erreur lors de la lecture du cache"

msgid "CACHE_LOAD"
msgstr "CHARG_CACHE"

msgid "Failed to load cached cert"
msgstr "Échec du chargement du certificat en cache"

msgid "Could not save certificate to cache"
msgstr "Impossible de sauvegarder le certificat dans le cache"

#, python-brace-format
msgid "Checking: {url}"
msgstr "Vérification : {url}"

msgid "OCSP_CHECK"
msgstr "VÉRIF_OCSP"

msgid "OCSP_FAILED"
msgstr "ÉCHEC_OCSP"

msgid "OCSP request failed"
msgstr "La requête OCSP a échoué"

msgid "Using cached CRL for"
msgstr "Utilisation de la CRL en cache pour"

msgid "CRL_CACHE"
msgstr "CACHE_CRL"

msgid "CRL_FETCH"
msgstr "RÉCUP_CRL"

msgid "Downloading CRL"
msgstr "Téléchargement de la CRL"

#, python-brace-format
msgid "Serial {serial_number} is REVOKED"
msgstr "Le numéro de série {serial_number} est RÉVOQUÉ"

msgid "CRL_RESULT"
msgstr "RÉSULTAT_CRL"

msgid "CRL_FAILED"
msgstr "ÉCHEC_CRL"

msgid "Failed to check CRL"
msgstr "Échec de la vérification CRL"

msgid "Could not save CRL to cache"
msgstr "Impossible de sauvegarder la CRL dans le cache"

msgid "SystemProvider"
msgstr "FournisseurSystème"

#, python-brace-format
msgid "Could not load system truststore: {error}"
msgstr "Impossible de charger le magasin de confiance du système : {error}"

msgid "Processing Group"
msgstr "Traitement du groupe"

msgid "Export"
msgstr "Exportation"

msgid "Using PEM sequence fallback for legacy environment"
msgstr ""
"Utilisation du mode de secours (séquence PEM) voor l'environnement hérité"

#, python-brace-format
msgid "Bundle saved to {path}"
msgstr "Lot enregistré sous {path}"

#, python-brace-format
msgid "Failed to create bundle: {error}"
msgstr "Échec de la création du lot: {error}"

#, python-brace-format
msgid "{used} of the {total} system certificates used"
msgstr "{used} des {total} certificats système utilisés"

msgid "System usage"
msgstr "Utilisation du système"

#, python-brace-format
msgid ""
"The cryptographic signature from issuer '{issuer}' is invalid or could not "
"be verified."
msgstr ""
"La signature cryptographique de l'émetteur '{issuer}' est invalide ou n'a "
"pas pu être vérifiée."

#, python-brace-format
msgid "Issuer '{issuer}' is not a CA or lacks keyCertSign usage."
msgstr ""
"L'émetteur '{issuer}' n'est pas une CA ou ne possède pas l'usage "
"'keyCertSign'."

#, python-brace-format
msgid ""
"The issuer '{issuer}' could not be found in the truststore, making this "
"chain untrusted."
msgstr ""
"L'émetteur '{issuer}' est introuvable dans le magasin de confiance, rendant "
"cette chaîne non fiable."

msgid ""
"This certificate is untrusted because it or an issuer in its chain has been "
"revoked."
msgstr ""
"Ce certificat n'est pas fiable car il a été révoqué, ou l'un de ses "
"émetteurs dans la chaîne l'a été."

#, python-brace-format
msgid ""
"RSA key size ({bits} bits) is below the minimum required {min_bits} bits."
msgstr ""
"La taille de la clé RSA ({bits} bits) est inférieure au minimum requis de "
"{min_bits} bits."

#, python-brace-format
msgid ""
"ECC key size ({bits} bits) is below the minimum required {min_bits} bits."
msgstr ""
"La taille de la clé ECC ({bits} bits) est inférieure au minimum requis de "
"{min_bits} bits."

msgid "The signature algorithm is unknown or unsupported by the system."
msgstr "L'algorithme de signature est inconnu ou non supporté par le système."

msgid "Certificate is missing a hashing algorithm for its signature."
msgstr ""
"Le certificat ne contient pas d'algorithme de hachage pour sa signature."

#, python-brace-format
msgid "Certificate uses a deprecated hash algorithm ({name})."
msgstr "Le certificat utilise un algorithme de hachage obsolète ({name})."

msgid "End-entity certificate lacks Extended Key Usage extension."
msgstr ""
"Le certificat d'entité finale ne possède pas l'extension Extended Key Usage "
"(EKU)."

msgid ""
"Certificate contains 'Any Extended Key Usage', which is overly permissive."
msgstr ""
"Le certificat contient 'Any Extended Key Usage', ce qui est trop permissif."

msgid ""
"Certificate allows both Server Auth and Code Signing. Functional separation "
"is recommended."
msgstr ""
"Le certificat autorise à la fois l'authentification serveur et la signature "
"de code. Une séparation fonctionnelle est recommandée."

msgid "Could not parse Extended Key Usage extension data."
msgstr "Impossible d'analyser les données de l'extension Extended Key Usage."

msgid "Server Authentication"
msgstr "Authentification Serveur"

msgid "Client Authentication"
msgstr "Authentification Client"

msgid "Code Signing"
msgstr "Signature de code"

msgid "Email Protection"
msgstr "Protection de messagerie"

msgid "Time Stamping"
msgstr "Horodatage"

msgid "OCSP Signing"
msgstr "Signature OCSP"

msgid "IPSec User"
msgstr "Utilisateur IPSec"

msgid "IPSec Intermediate"
msgstr "Intermédiaire IPSec"

msgid "IPSec Tunnel"
msgstr "Tunnel IPSec"

#, python-brace-format
msgid "Unknown ({oid})"
msgstr "Inconnu ({oid})"

#, python-brace-format
msgid "Validity period ({days} days) exceeds the 398-day limit."
msgstr ""
"La période de validité du certificat ({days} jours) dépasse la limite de 398 "
"jours."

#, python-brace-format
msgid "Common Name '{cn}' is missing from Subject Alternative Names (SAN)."
msgstr "Le Common Name '{cn}' est absent des Subject Alternative Names (SAN)."

#, python-brace-format
msgid ""
"SAN contains a non-FQDN '{name}', which is disallowed for public "
"certificates."
msgstr ""
"Le SAN contient un nom non-FQDN '{name}', ce qui est interdit pour les "
"certificats publics."

msgid "Certificate lacks a SAN extension. Relying solely on CN is deprecated."
msgstr ""
"Le certificat n'a pas d'extension SAN. L'utilisation exclusive du CN est "
"obsolète."

msgid ""
"Certificate lacks CRL Distribution Points (CDP). Revocation checking may be "
"limited."
msgstr ""
"Le certificat ne contient pas de points de distribution CRL (CDP). La "
"vérification de révocation peut être limitée."

#, python-brace-format
msgid ""
"Path length constraint exceeded. Issuer allows max {limit} intermediate(s)."
msgstr ""
"Contrainte de longueur de chaîne dépassée. L'émetteur autorise max {limit} "
"intermédiaire(s)."

#, python-brace-format
msgid ""
"Hostname mismatch: Certificate is valid for '{names}', but you connected to "
"'{target}'."
msgstr ""
"Erreur de nom d'hôte : Le certificat est valide pour '{names}', mais vous "
"êtes connecté à '{target}'."

#, python-brace-format
msgid "Netscape Comment found: {comment}"
msgstr "Commentaire Netscape trouvé : {comment}"

#, python-brace-format
msgid "Certificate name '{name}' is not permitted by issuer constraints."
msgstr "Le nom du certificat '{name}' n'est pas autorisé par les contraintes de l'émetteur."

#, python-brace-format
msgid "Certificate name '{name}' is explicitly excluded by the issuer."
msgstr "Le nom du certificat '{name}' est explicitement exclu par l'émetteur."

msgid "Invalid DER structure"
msgstr "Structure DER invalide"

#, python-brace-format
msgid "Maximum certificate limit ({limit}) reached."
msgstr "Limite maximale de certificats ({limit}) atteinte."

msgid "Skipping duplicate certificate (already loaded)"
msgstr "Saut du certificat en double (déjà chargé)"

msgid "DUPLICATE"
msgstr "DOUBLON"

msgid "Invalid certificate structure"
msgstr "Structure de certificat invalide"

msgid "PKCS7-container"
msgstr "Conteneur-PKCS7"

msgid "Legacy cryptography detected, falling back."
msgstr "Cryptographie obsolète détectée, mode de repli activé."

#, python-brace-format
msgid "Failed to parse PKCS7: {error}"
msgstr "Échec de l'analyse du PKCS7 : {error}"

#, python-brace-format
msgid "Maximum certificate limit ({limit}) reached. Stopping scan."
msgstr "Limite maximale de certificats ({limit}) atteinte. Arrêt de l'analyse."

#, python-brace-format
msgid "File too large ({size:.1f}MB)"
msgstr "Fichier trop volumineux ({size:.1f} Mo)"

msgid "Unknown JSON format or malformed structure."
msgstr "Format JSON inconnu ou structure malformée."

msgid "Unnamed Store"
msgstr "Magasin sans nom"

msgid "Certificate not found in {}"
msgstr "Certificat introuvable dans {}"

msgid "MISSING"
msgstr "MANQUANT"

msgid "Jinja2 Render Error"
msgstr "Erreur de rendu Jinja2"

msgid "Jinja2 not found. Using regex fallback."
msgstr "Jinja2 introuvable. Utilisation du mode de repli regex."

msgid "YAML Syntax Error"
msgstr "Erreur de syntaxe YAML"

msgid ""
"Found unquoted Jinja2 delimiters. Wrap expressions like '{{ var }}' in "
"quotes."
msgstr ""
"Délimiteurs Jinja2 non cités détectés. Encadrez les expressions comme "
"'{{ var }}' par des guillemets."

msgid "YAML Parse Error"
msgstr "Erreur d'analyse YAML"

msgid "Group contains no valid certificates."
msgstr "Le groupe ne contient aucun certificat valide."

msgid "EMPTY_GROUP"
msgstr "GROUPE_VIDE"

#, python-brace-format
msgid "Initiating TLS connection to {host}:{port}"
msgstr "Initialisation de la connexion TLS vers {host}:{port}"

#, python-brace-format
msgid "Failed to fetch certificate from {host}"
msgstr "Échec de la récupération du certificat depuis {host}"

msgid "Unknown format: {}"
msgstr "Format inconnu : {}"

msgid "SIG_INVALID"
msgstr "SIG_INVALIDE"

msgid "NO_TRUST"
msgstr "NON_FIABLE"

msgid "UNTRUSTED_CHAIN"
msgstr "CHAÎNE_NON_FIABLE"

msgid "CHAIN_BROKEN"
msgstr "CHAÎNE_ROMPUE"

msgid "CIRCULAR_PATH"
msgstr "CHEMIN_CIRCULAIRE"

msgid "COMMENT"
msgstr "COMMENTAIRE"

msgid "Certificate Hierarchy:"
msgstr "Hiérarchie des certificats :"

msgid "Unnamed Group"
msgstr "Groupe sans nom"

msgid "(No certificates found)"
msgstr "(Aucun certificat trouvé)"

msgid "EXTERNAL ISSUER / MISSING ROOT"
msgstr "ÉMETTEUR EXTERNE / ROOT MANQUANT"

msgid "CIRCULAR REFERENCE"
msgstr "RÉFÉRENCE CIRCULAIRE"

msgid "Usage"
msgstr "Utilisation"

msgid "ALT"
msgstr "ALT"

msgid "ERROR"
msgstr "ERREUR"

msgid "WARNING"
msgstr "AVERTISSEMENT"

msgid "OK"
msgstr "OK"

msgid "INFO"
msgstr "INFO"

msgid "CHAIN"
msgstr "CHAÎNE"

msgid "EXPIRED"
msgstr "EXPIRÉ"

msgid "EXPIRING"
msgstr "EXPIRATION"

msgid "SYSTEM"
msgstr "SYSTÈME"

msgid "PARENT_NOT_A_CA"
msgstr "PARENT_NON_CA"

#, python-brace-format
msgid ""
"TrustStore Analyzer v{version} - Analyze certificate truststores and "
"visualize the chain hierarchy."
msgstr ""
"TrustStore Analyzer v{version} - Analysez les magasins de certificats et "
"visualisez la hiérarchie des chaînes."

msgid "Compatible with Python 3.6+"
msgstr "Compatible avec Python 3.6+"

msgid "Show this help message and exit"
msgstr "Afficher ce message d'aide et quitter"

msgid "Show program's version number and exit"
msgstr "Afficher le numéro de version du programme et quitter"

msgid "Path to the input source(s)"
msgstr "Chemin vers la ou les sources d'entrée"

msgid "Input & Network Configuration"
msgstr "Configuration d'entrée et réseau"

msgid "Incorporate system truststore"
msgstr "Inclure le magasin de confiance du système"

msgid "Allow internet access for AIA discovery and revocation checks"
msgstr ""
"Autoriser l'accès Internet pour la découverte AIA et les vérifications de "
"révocation"

msgid "Bypass local cache and force download of AIA/CRL/OCSP data"
msgstr ""
"Ignorer le cache local et forcer le téléchargement des données AIA/CRL/OCSP"

msgid "Override safety limits (max file size and certificate count)"
msgstr ""
"Outrepasser les limites de sécurité (taille de fichier et nombre de "
"certificats)"

msgid "Analysis Settings"
msgstr "Paramètres d'analyse"

msgid "Expiration threshold in days (default: 30)"
msgstr "Seuil d'expiration en jours (par défaut : 30)"

msgid "Maximum recursion depth for chain discovery (default: 4)"
msgstr ""
"Profondeur de récursion maximale pour la découverte de chaîne (par défaut : "
"4)"

msgid "Output & Debugging"
msgstr "Sortie et débogage"

msgid "Output format"
msgstr "Format de sortie"

msgid "Increase output verbosity (e.g., -v for SANs, -vv for policy findings)"
msgstr ""
"Augmenter la verbosité (ex: -v pour les SAN, -vv pour les rapports de "
"politique)"

msgid "Show debug info"
msgstr "Afficher les informations de débogage"

msgid "Export Options"
msgstr "Options d'exportation"

msgid "Export a complete PKCS#7 (.p7b) bundle for each analyzed group"
msgstr "Exporter un lot PKCS#7 (.p7b) complet pour chaque groupe analysé"

msgid "Directory where bundles will be saved (default: output_bundles)"
msgstr ""
"Répertoire où les lots seront enregistrés (par défaut : output_bundles)"

msgid "Parameter '-o' is unknown"
msgstr "Le paramètre '-o' est inconnu"

msgid "Did you mean '-O' (uppercase) for online discovery?"
msgstr "Vouliez-vous dire '-O' (majuscule) pour la découverte en ligne ?"

msgid "Stdin requested via '-' but no data piped."
msgstr "Stdin demandé via '-' mais aucune donnée n'a été transmise."

msgid "No certificates found via this provider."
msgstr "Aucun certificat trouvé via ce fournisseur."

msgid "Could not determine provider for this input."
msgstr "Impossible de déterminer le fournisseur pour cette entrée."

msgid "No certificates found to display."
msgstr "Aucun certificat à afficher."

msgid "Analysis interrupted by user"
msgstr "Analyse interrompue par l'utilisateur"

msgid "An unexpected error occurred"
msgstr "Une erreur inattendue est survenue"

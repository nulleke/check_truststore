#, python-brace-format
msgid "Missing issuer for: {name}"
msgstr "Ontbrekende issuer voor: {name}"

msgid "UNTRUSTED"
msgstr "GEEN_TRUST"

msgid "The certificate chain leads to an untrusted or missing root."
msgstr ""
"De certificaatketen leidt naar een niet-vertrouwde of ontbrekende root."

msgid "The certificate chain is incomplete due to a missing upstream issuer."
msgstr ""
"De certificaatketen is incompleet door een ontbrekende bovenliggende "
"uitgever."

msgid ""
"The chain is untrusted because an upstream issuer is blacklisted by the OS."
msgstr ""
"De keten wordt niet vertrouwd omdat een bovenliggende uitgever op de "
"blacklist van het besturingssysteem staat."

#, python-brace-format
msgid "AIA: {name}"
msgstr "AIA: {name}"

msgid "Successfully discovered issuer via AIA"
msgstr "Uitgever succesvol gevonden via AIA"

msgid "The chain is broken; an issuer (Root or Intermediate) was not found."
msgstr ""
"De keten is verbroken; een uitgever (Root of Intermediate) is niet gevonden."

msgid "A circular certificate reference was detected."
msgstr "Er is een circulaire certificaatverwijzing gedetecteerd."

#, python-brace-format
msgid ""
"The cryptographic signature from issuer '{issuer}' is invalid or could not "
"be verified."
msgstr ""
"De cryptografische handtekening van uitgever '{issuer}' is ongeldig of kon "
"niet worden geverifieerd."

#, python-brace-format
msgid "Issuer '{issuer}' is not a CA or lacks keyCertSign usage."
msgstr "Uitgever '{issuer}' is geen CA of mist de 'keyCertSign' rechten."

#, python-brace-format
msgid ""
"The issuer '{issuer}' could not be found in the truststore, making this "
"chain untrusted."
msgstr ""
"De uitgever '{issuer}' is niet gevonden in de truststore, waardoor deze "
"keten niet wordt vertrouwd."

msgid ""
"This certificate is untrusted because it or an issuer in its chain has been "
"revoked."
msgstr ""
"Dit certificaat wordt niet vertrouwd omdat het certificaat zelf of een "
"uitgever in de keten is ingetrokken (revoked)."

msgid ""
"Certificate lacks Signed Certificate Timestamps (SCT). Not CT-compliant."
msgstr "Certificaat mist Signed Certificate Timestamps (SCT). Niet CT-conform."

#, python-brace-format
msgid ""
"RSA key size ({bits} bits) is below the minimum required {min_bits} bits."
msgstr ""
"RSA-sleutelgrootte ({bits} bits) is kleiner dan de minimaal vereiste "
"{min_bits} bits."

#, python-brace-format
msgid ""
"ECC key size ({bits} bits) is below the minimum required {min_bits} bits."
msgstr ""
"ECC-sleutelgrootte ({bits} bits) is kleiner dan de minimaal vereiste "
"{min_bits} bits."

msgid "The signature algorithm is unknown or unsupported by the system."
msgstr ""
"Het handtekening-algoritme is onbekend of wordt niet ondersteund door het "
"systeem."

msgid "Certificate is missing a hashing algorithm for its signature."
msgstr "Het certificaat mist een hashing-algoritme voor de handtekening."

#, python-brace-format
msgid "Certificate uses a deprecated hash algorithm ({name})."
msgstr "Het certificaat gebruikt een verouderd hash-algoritme ({name})."

msgid "End-entity certificate lacks Extended Key Usage extension."
msgstr "End-entity certificaat mist de 'Extended Key Usage' (EKU) extensie."

msgid ""
"Certificate contains 'Any Extended Key Usage', which is overly permissive."
msgstr ""
"Certificaat bevat 'Any Extended Key Usage', wat overmatig permissief is."

msgid ""
"Certificate allows both Server Auth and Code Signing. Functional separation "
"is recommended."
msgstr ""
"Certificaat staat zowel Server Auth als Code Signing toe. Functionele "
"scheiding wordt aanbevolen."

msgid "Could not parse Extended Key Usage extension data."
msgstr "Kon de 'Extended Key Usage' data niet verwerken."


msgstr ""
"Certificaat mist CRL-distributiepunten (CDP). Intrekkingscontrole is "
"mogelijk beperkt."

#, python-brace-format
msgid ""
"Path length constraint exceeded. Issuer allows max {limit} intermediate(s)."
msgstr ""
"Padlengte-beperking overschreden. Uitgever staat maximaal {limit} tussen-"
